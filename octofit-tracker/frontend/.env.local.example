# Environment variables for OctoFit Tracker Frontend
# Copy this file to .env.local and configure your values

# GitHub Codespaces Name (optional)
# When running in GitHub Codespaces, set this to your codespace name
# to connect to the backend API running on port 8000.
# Leave unset for local development (will use localhost:8000).
#
# Example: VITE_CODESPACE_NAME=my-codespace-name
# The API base URL will become: https://my-codespace-name-8000.app.github.dev/api
#
# For local development:
# Leave this commented out or unset, and the app will use http://localhost:8000/api
#
# To get your Codespace name in GitHub Codespaces:
# 1. Run: echo $CODESPACE_NAME
# 2. Copy the output and set it here
#
VITE_CODESPACE_NAME=
